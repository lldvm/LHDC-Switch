+    bindata: &mut [u8],
+    first_idx: &mut i32,
+    max_idx: i32,
+) {
+    let mut compare = in_0[1];
+    compare = if compare < 0_i32 { -compare } else { compare };
+    let mut index = *first_idx;
+    index = index_calc(index, max_idx, compare, *first_idx);
+    *first_idx = index;
