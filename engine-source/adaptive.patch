+            ((f_out_1[0].r as i64 * (2147483647 / 5) as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
+        f_out_1[0].i =
+            ((f_out_1[0].i as i64 * (2147483647 / 5) as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
+        f_out_2[0].r =
+            ((f_out_2[0].r as i64 * (2147483647 / 5) as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
