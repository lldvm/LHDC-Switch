+            - ((scratch[9].r as i64 * yb.i as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
+        f_out_1[0].r = scratch[5].r - scratch[6].r;
+        f_out_1[0].i = scratch[5].i - scratch[6].i;
