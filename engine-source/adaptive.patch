+static JUMP_TABLE: [i32; 64] = [
+    6, 13, 19, 26, 32, 38, 45, 51, 58, 64, 77, 90, 102, 115, 128, 141, 154, 166, 186, 205, 224,
+    243, 262, 282, 301, 326, 352, 378, 403, 429, 461, 493, 525, 557, 595, 634, 672, 717, 762, 813,
