+// start time.
+static LARGE_INTEGER media_clock_start, media_clock_frequency;
+
+static bool run_loop_exit_requested;
+
+// to trigger run loop from other thread
+static HANDLE btstack_run_loop_windows_callbacks_mutex;
+static btstack_data_source_t btstack_run_loop_windows_process_callbacks_ds;
+static btstack_data_source_t btstack_run_loop_windows_poll_data_sources_ds;
+
+/**
+ * @brief Queries the current time in ms since start
+ */
+static uint32_t btstack_run_loop_windows_get_time_ms(void){
+
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    const uint64_t elapsed = (uint64_t)(now.QuadPart - media_clock_start.QuadPart);
+    const uint64_t frequency = (uint64_t)media_clock_frequency.QuadPart;
+    uint32_t time_ms = (uint32_t)((elapsed / frequency) * 1000 + (elapsed % frequency) * 1000 / frequency);
+    return time_ms;
+}
+
+/**
+ * Execute run_loop
+ */
+static void btstack_run_loop_windows_execute(void) {
+
+    btstack_linked_list_iterator_t it;
+
+    // LHDC Switch: high-resolution, event-driven timer; no global timeBeginPeriod.
+    HANDLE media_timer = CreateWaitableTimerExW(NULL, NULL, 0x2, TIMER_ALL_ACCESS);
+
+    // clear exit flag
+    run_loop_exit_requested = false;
+
+    while (run_loop_exit_requested == false) {
+
+        // process timers
+        uint32_t now_ms = btstack_run_loop_windows_get_time_ms();
+        btstack_run_loop_base_process_timers(now_ms);
+
+        // get next timeout
+        int32_t timeout_ms = btstack_run_loop_base_get_time_until_timeout(now_ms);
+        if (timeout_ms < 0){
+            timeout_ms = INFINITE;
+        }
+
+        // collect handles to wait for
+        HANDLE handles[100];
+        memset(handles, 0, sizeof(handles));
+        int num_handles = 0;
+        btstack_linked_list_iterator_init(&it, &btstack_run_loop_base_data_sources);
+        while (btstack_linked_list_iterator_has_next(&it)){
+            btstack_data_source_t *ds = (btstack_data_source_t*) btstack_linked_list_iterator_next(&it);
+            if (ds->source.handle == 0) continue;
+            if (ds->flags & (DATA_SOURCE_CALLBACK_READ | DATA_SOURCE_CALLBACK_WRITE)){
+                handles[num_handles++] = ds->source.handle;
+                log_debug("btstack_run_loop_execute adding handle %p", ds->source.handle);
+            }
+        }
+
+        // Keep the run loop responsive to USB/HCI while a media deadline waits.
+        // If high-resolution timers are unavailable, retain the original timeout.
+        if (media_timer && timeout_ms > 0 && num_handles < MAXIMUM_WAIT_OBJECTS) {
+            LARGE_INTEGER due;
+            due.QuadPart = -(LONGLONG)timeout_ms * 10000;
+            if (SetWaitableTimer(media_timer, &due, 0, NULL, NULL, FALSE)) {
+                handles[num_handles++] = media_timer;
+                timeout_ms = INFINITE;
+            }
+        }
+        // wait for timeout or data source to become ready
+        DWORD res;
+        if (num_handles){
+            // wait for ready Events or timeout
+            res = WaitForMultipleObjects(num_handles, &handles[0], 0, timeout_ms);
+        } else {
+            // just wait for timeout
+            Sleep(timeout_ms);
+            res = WAIT_TIMEOUT;
+        }
+
+        // process data source
+        if (WAIT_OBJECT_0 <= res && res < (WAIT_OBJECT_0 + num_handles)){
+            void * triggered_handle = handles[res - WAIT_OBJECT_0];
+            btstack_linked_list_iterator_init(&it, &btstack_run_loop_base_data_sources);
+            while (btstack_linked_list_iterator_has_next(&it)){
+                btstack_data_source_t *ds = (btstack_data_source_t*) btstack_linked_list_iterator_next(&it);
+                log_debug("btstack_run_loop_windows_execute: check ds %p with handle %p\n", ds, ds->source.handle);
+                if (triggered_handle == ds->source.handle){
+                    if (ds->flags & DATA_SOURCE_CALLBACK_READ){
+                        log_debug("btstack_run_loop_windows_execute: process read ds %p with handle %p\n", ds, ds->source.handle);
+                        ds->process(ds, DATA_SOURCE_CALLBACK_READ);
+                    } else if (ds->flags & DATA_SOURCE_CALLBACK_WRITE){
+                        log_debug("btstack_run_loop_windows_execute: process write ds %p with handle %p\n", ds, ds->source.handle);
+                        ds->process(ds, DATA_SOURCE_CALLBACK_WRITE);
+                    }
+                    break;
+                }
+            }
+        }
+    }
+    if (media_timer) CloseHandle(media_timer);
+}
+
+static void btstack_run_loop_windows_trigger_exit(void){
+    run_loop_exit_requested = true;
+}
+
+// set timer
+static void btstack_run_loop_windows_set_timer(btstack_timer_source_t *a, uint32_t timeout_in_ms){
+    uint32_t time_ms = btstack_run_loop_windows_get_time_ms();
+    a->timeout = time_ms + timeout_in_ms;
+    log_debug("btstack_run_loop_windows_set_timer to %u ms (now %u, timeout %u)", a->timeout, time_ms, timeout_in_ms);
+}
+
+static void btstack_run_loop_windows_process_callbacks_handler(btstack_data_source_t * ds, btstack_data_source_callback_type_t callback_type){
+    UNUSED(callback_type);
+
+    // execute callbacks
+    while (1){
+        // protect list with mutex (Win32 style)
+        DWORD dwWaitResult = WaitForSingleObject( btstack_run_loop_windows_callbacks_mutex, INFINITE);
+        if (dwWaitResult != WAIT_OBJECT_0) return;
+
+        btstack_context_callback_registration_t * callback_registration = (btstack_context_callback_registration_t *) btstack_linked_list_pop(&btstack_run_loop_base_callbacks);
+        ReleaseMutex(btstack_run_loop_windows_callbacks_mutex);
+
+        if (callback_registration == NULL){
+            break;
+        }
+        (*callback_registration->callback)(callback_registration->context);
+    }
+}
+
+static void btstack_run_loop_windows_execute_on_main_thread(btstack_context_callback_registration_t * callback_registration){
+    if (btstack_run_loop_windows_process_callbacks_ds.source.handle == NULL) return;
+
+    // protect list with mutex (Win32 style)
+    DWORD dwWaitResult = WaitForSingleObject( btstack_run_loop_windows_callbacks_mutex, INFINITE);
+    if (dwWaitResult != WAIT_OBJECT_0) return;
+
+    // We own mutex now, add callback to list
+    btstack_run_loop_base_add_callback(callback_registration);
+    ReleaseMutex(btstack_run_loop_windows_callbacks_mutex);
+    // trigger run loop
+    SetEvent(btstack_run_loop_windows_process_callbacks_ds.source.handle);
+}
+
+
+static void btstack_run_loop_windows_poll_data_sources_handler(btstack_data_source_t * ds, btstack_data_source_callback_type_t callback_type){
+    UNUSED(callback_type);
+    btstack_run_loop_base_poll_data_sources();
+}
+
+static void btstack_run_loop_windows_poll_data_sources_from_irq(void){
+    SetEvent(btstack_run_loop_windows_poll_data_sources_ds.source.handle);
+}
+
+static void btstack_run_loop_windows_init(void){
+    btstack_run_loop_base_init();
+
+    // Monotonic QPC clock: Windows wall-clock adjustments cannot move media deadlines.
+    QueryPerformanceFrequency(&media_clock_frequency);
+    QueryPerformanceCounter(&media_clock_start);
+
+    // Create mutex with no initial owner
+    btstack_run_loop_windows_callbacks_mutex = CreateMutex(
+        NULL,              // default security attributes
+        FALSE,             // initially not owned
+        NULL);             // unnamed mutex
+    if (btstack_run_loop_windows_callbacks_mutex == NULL){
+        log_info("CreateMutex error: %ld\n", GetLastError());
+        return;
+    }
+
+    // create Event that can be notified from other thread. bManualReset is fALSE => Object is auto-reset
+    btstack_run_loop_windows_process_callbacks_ds.source.handle  = CreateEvent(NULL, FALSE, FALSE, NULL);
+    btstack_run_loop_enable_data_source_callbacks(&btstack_run_loop_windows_process_callbacks_ds, DATA_SOURCE_CALLBACK_READ);
+    btstack_run_loop_set_data_source_handler(&btstack_run_loop_windows_process_callbacks_ds, &btstack_run_loop_windows_process_callbacks_handler);
+    btstack_run_loop_add_data_source(&btstack_run_loop_windows_process_callbacks_ds);
+
+    btstack_run_loop_windows_poll_data_sources_ds.source.handle  = CreateEvent(NULL, FALSE, FALSE, NULL);
+    btstack_run_loop_enable_data_source_callbacks(&btstack_run_loop_windows_poll_data_sources_ds, DATA_SOURCE_CALLBACK_READ);
+    btstack_run_loop_set_data_source_handler(&btstack_run_loop_windows_poll_data_sources_ds, &btstack_run_loop_windows_poll_data_sources_handler);
+    btstack_run_loop_add_data_source(&btstack_run_loop_windows_poll_data_sources_ds);
+}
+
+static const btstack_run_loop_t btstack_run_loop_windows = {
+    &btstack_run_loop_windows_init,
+    &btstack_run_loop_base_add_data_source,
+    &btstack_run_loop_base_remove_data_source,
+    &btstack_run_loop_base_enable_data_source_callbacks,
+    &btstack_run_loop_base_disable_data_source_callbacks,
+    &btstack_run_loop_windows_set_timer,
+    &btstack_run_loop_base_add_timer,
+    &btstack_run_loop_base_remove_timer,
+    &btstack_run_loop_windows_execute,
+    &btstack_run_loop_base_dump_timer,
+    &btstack_run_loop_windows_get_time_ms,
+    &btstack_run_loop_windows_poll_data_sources_from_irq,
+    &btstack_run_loop_windows_execute_on_main_thread,
+    &btstack_run_loop_windows_trigger_exit
+};
+
+/**
+ * Provide btstack_run_loop_windows instance
+ */
+const btstack_run_loop_t * btstack_run_loop_windows_get_instance(void){
+    return &btstack_run_loop_windows;
+}
+
diff --git a/app/src/crates/codec/src/lhdc_abr.rs b/app/src/crates/codec/src/lhdc_abr.rs
new file mode 100644
--- /dev/null
+++ b/app/src/crates/codec/src/lhdc_abr.rs
@@ -0,0 +1,141 @@
+//! LHDC Switch adaptive policy. Time based, independent of packet size/rate.
+use std::time::Duration;
+
+pub(crate) struct Abr {
+    pub table: Vec<u32>,
+    pub index: usize,
+    pub start: usize,
+    clear_since: Duration,
+    congested_since: Option<Duration>,
+    next_probe: Duration,
+    probe_delay: Duration,
+    /// Failed probes pause only that stage, never lower the session ceiling.
+    blocked_probe: Option<(usize, Duration)>,
+    next_reduction: Duration,
+    last_raise: Option<(usize, Duration)>,
+}
+
+impl Abr {
+    pub fn new(rates: &[u32], min: usize, max: usize, cap: u32) -> Self {
+        let ceiling = rates[max].min(cap).max(rates[min]);
+        let table: Vec<_> = rates.iter().enumerate()
+            .filter(|(i, r)| *i >= min && *i <= max && **r <= ceiling && **r >= 160)
+            .map(|(_, r)| *r).collect();
+        let table = if table.is_empty() { vec![rates[min]] } else { table };
+        let start = table.iter().rposition(|r| *r <= 400).unwrap_or(0);
+        Self { table, index: start, start, clear_since: Duration::ZERO,
+            congested_since: None, next_probe: Duration::from_secs(5), probe_delay: Duration::from_secs(15),
+            blocked_probe: None, next_reduction: Duration::ZERO, last_raise: None }
+    }
+
+    // A few packets are normal with 10 ms capture bursts. Sustained backlog
+    // reduces rate before the 64-packet ring fills; severe backlog acts at once.
+    pub fn target(&mut self, queue: u32, now: Duration) -> Option<usize> {
+        if queue >= 4 {
+            self.clear_since = now;
+            if now < Duration::from_secs(2) && queue < 24 { return None; }
+            let since = *self.congested_since.get_or_insert(now);
+            if self.index > 0 && now >= self.next_reduction
+                && (queue >= 24 || now.saturating_sub(since) >= Duration::from_millis(60)) {
+                if let Some((raised, at)) = self.last_raise.take() {
+                    if raised == self.index && now.saturating_sub(at) <= Duration::from_secs(6) {
+                        self.blocked_probe = Some((raised,now + Duration::from_secs(60)));
+                    }
+                }
+                self.congested_since = Some(now);
+                let target=if queue >= 24 { self.start.min(self.index - 1) } else { self.index.saturating_sub(2) };
+                self.next_reduction=now+Duration::from_millis(250);
+                // Recover ordinary audio quality promptly after the link clears;
+                // a series of downshifts must not leave a 60 s floor penalty.
+                self.next_probe = now + if target < self.start {Duration::from_secs(10)} else {self.probe_delay};
+                self.probe_delay = (self.probe_delay * 2).min(Duration::from_secs(60));
+                return Some(target);
+            }
+        } else {
+            self.congested_since = None;
+            if queue > 1 { self.clear_since = now; }
+            let hold = if self.table.get(self.index + 1).is_some_and(|r| *r >= 900) { 20 }
+                else if self.index < self.start {3} else {5};
+            let probe_blocked=self.blocked_probe.is_some_and(|(stage,until)| self.index+1>=stage && now<until);
+            if queue <= 1 && self.index + 1 < self.table.len() && !probe_blocked && now >= self.next_probe
+                && now.saturating_sub(self.clear_since) >= Duration::from_secs(hold) {
+                self.clear_since = now;
+                self.next_probe = now + Duration::from_secs(if self.index < self.start {3} else {5});
+                self.probe_delay = Duration::from_secs(15);
+                self.last_raise = Some((self.index + 1, now));
+                return Some(self.index + 1);
+            }
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const R: [u32; 9] = [64,160,192,256,320,400,500,900,1000];
+    #[test]
+    fn climbs_to_requested_ceiling_and_stays_there() {
+        for cap in [400,500,900,1000] {
+            let mut a = Abr::new(&R,0,8,cap);
+            assert_eq!(a.table[a.index],400);
+            for t in 0..100 { if let Some(i)=a.target(0,Duration::from_secs(t)) { a.index=i; } }
+            assert_eq!(a.table[a.index],cap);
+        }
+    }
+    #[test]
+    fn honors_peer_and_mtu_limits_and_minimum() {
+        assert_eq!(*Abr::new(&R,0,5,1000).table.last().unwrap(),400);
+        assert_eq!(*Abr::new(&R,0,7,1000).table.last().unwrap(),900);
+        assert_eq!(Abr::new(&R,5,8,160).table,vec![400]);
+        let r44=[64,160,192,240,320,400,480,900,1000];
+        assert_eq!(*Abr::new(&r44,0,8,500).table.last().unwrap(),480);
+    }
+    #[test]
+    fn backs_off_rapidly_then_waits_before_retry() {
+        let mut a=Abr::new(&R,0,8,1000); a.index=7;
+        let t=Duration::from_secs(20);
+        let i=a.target(24,t).unwrap(); assert_eq!(a.table[i],400); a.index=i;
+        assert_eq!(a.target(0,t+Duration::from_secs(5)),None);
+        assert!(a.target(0,t+Duration::from_secs(15)).is_some());
+        assert_eq!(a.target(4,t+Duration::from_secs(16)),None);
+        assert!(a.target(4,t+Duration::from_millis(16060)).is_some());
+    }
+    #[test]
+    fn tolerates_short_capture_bursts() {
+        let mut a=Abr::new(&R,0,8,1000);
+        assert_eq!(a.target(5,Duration::from_millis(10)),None);
+        assert_eq!(a.target(0,Duration::from_millis(20)),None);
+        assert_eq!(a.target(5,Duration::from_millis(30)),None);
+    }
+    #[test]
+    fn failed_probe_retries_after_cooldown_instead_of_permanently_capping_stream() {
+        let mut a=Abr::new(&R,0,8,1000);
+        for t in [5,25] { let i=a.target(0,Duration::from_secs(t)).unwrap(); a.index=i; }
+        assert_eq!(a.table[a.index],900);
+        let i=a.target(24,Duration::from_secs(26)).unwrap(); a.index=i;
+        for t in 27..86 { if let Some(i)=a.target(0,Duration::from_secs(t)) { a.index=i; } }
+        assert_eq!(a.table[a.index],500);
+        for t in 86..180 { if let Some(i)=a.target(0,Duration::from_secs(t)) { a.index=i; } }
+        assert_eq!(a.table[a.index],1000);
+    }
+    #[test]
+    fn reductions_wait_for_the_previous_change_and_floor_recovers() {
+        let mut a=Abr::new(&R,0,8,900);a.index=6;
+        let t=Duration::from_secs(40);
+        let i=a.target(24,t).unwrap();a.index=i;
+        assert_eq!(a.target(24,t+Duration::from_millis(20)),None);
+        for dt in [250,500,750,1000] { if let Some(i)=a.target(24,t+Duration::from_millis(dt)) {a.index=i;} }
+        assert_eq!(a.table[a.index],160);
+        for seconds in 42..76 {if let Some(i)=a.target(0,Duration::from_secs(seconds)){a.index=i;}}
+        assert!(a.table[a.index]>=500);
+        for seconds in 76..110 {if let Some(i)=a.target(0,Duration::from_secs(seconds)){a.index=i;}}
+        assert_eq!(a.table[a.index],900);
+    }
+    #[test]
+    fn startup_grace_does_not_ignore_a_full_queue() {
+        let mut a=Abr::new(&R,0,8,900);
+        assert_eq!(a.target(7,Duration::from_millis(100)),None);
+        assert!(a.target(64,Duration::from_millis(200)).is_some());
+    }
+}
