+            // end a packet wait early. The Windows hook uses a high-res timer.
+            let wait = due.duration_since(now).min(Duration::from_millis(5));
+            if let Some(hook) = PACKET_WAIT_HOOK.get() { hook(wait); } else { std::thread::sleep(wait); }
+        }
+    }
+    sink.send(&timed);
