+            ((f_out_4[0].r as i64 * (2147483647 / 5) as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
+        f_out_4[0].i =
+            ((f_out_4[0].i as i64 * (2147483647 / 5) as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
+        scratch[0] = f_out_0[0];
+        scratch[1].r = ((f_out_1[0].r as i64 * (twiddles[u * fstride]).r as i64
