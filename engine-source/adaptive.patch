+++ b/app/src/crates/lhdcv5-sys/src/aosp.rs
@@ -0,0 +1,48 @@
+//! Native Windows adapter to the unmodified AOSP Rust encoder algorithms.
+//! This build does not link the C port. Transport and ABR live above this API.
+use crate::{EncodeOutput, Error, ffi};
+use lhdcv5::lhdc_api::{self as api, Context};
+use api::lhdc_api_internal::Error as Internal;
+
+fn map(e: api::Error) -> Error {
+    Error::Lhdc(match e {
+        api::Error::InvalidInputParam => ffi::LHDC_FRET_INVALID_INPUT_PARAM,
+        api::Error::InvalidCodec => ffi::LHDC_FRET_INVALID_CODEC,
+        api::Error::Internal(Internal::BufTooSmall) => ffi::LHDC_FRET_BUF_NOT_ENOUGH,
+        api::Error::Internal(Internal::CodecNotReady) => ffi::LHDC_FRET_CODEC_NOT_READY,
+        api::Error::Internal(Internal::InvalidInputParam) => ffi::LHDC_FRET_INVALID_INPUT_PARAM,
+        _ => ffi::LHDC_FRET_ERROR,
+    })
+}
+
+pub struct LhdcV5Enc { ctx: Box<Context>, mtu: usize }
+// SAFETY: exclusively owned heap context, no thread affinity or shared globals.
+// All mutable access requires &mut self, just like the C-port adapter.
+unsafe impl Send for LhdcV5Enc {}
+impl LhdcV5Enc {
+    pub fn new() -> Result<Self, Error> {
+        Ok(Self { ctx: Box::new(Context::new(api::LHDC_VERSION_1).map_err(map)?), mtu: 0 })
+    }
+    pub fn init_encoder(&mut self, rate: u32, bits: u32, quality: u32, mtu: u32, interval: u32) -> Result<(), Error> {
+        self.ctx.init_encoder(rate,bits,quality,api::LHDC_FRAME_5MS,mtu,interval).map_err(map)?;
+        self.mtu=mtu as usize;
+        Ok(())
+    }
+    pub fn block_size(&self) -> Result<u32, Error> { self.ctx.get_block_size().map_err(map) }
+    pub fn encode(&mut self, pcm: &[u8], out: &mut [u8]) -> Result<EncodeOutput, Error> {
+        // The AOSP packet copy assumes enough output space. Validate before
+        // entering it, including calls that have buffered PCM from a prior frame.
+        if out.len() < self.mtu { return Err(Error::Lhdc(ffi::LHDC_FRET_BUF_NOT_ENOUGH)); }
+        let (mut bytes,mut frames)=(0,0);
+        self.ctx.enc_process(pcm,out,&mut bytes,&mut frames).map_err(map)?;
+        Ok(EncodeOutput { bytes: bytes as usize, frames })
+    }
+    pub fn set_bitrate_index(&mut self, i: u32, status: bool) -> Result<(), Error> { self.ctx.set_target_bitrate_inx(i,status).map(|_|()).map_err(map) }
+    pub fn set_max_bitrate_index(&mut self, i: u32) -> Result<(), Error> { self.ctx.set_max_bitrate_inx(i).map(|_|()).map_err(map) }
+    pub fn set_min_bitrate_index(&mut self, i: u32) -> Result<(), Error> { self.ctx.set_min_bitrate_inx(i).map(|_|()).map_err(map) }
+    pub fn bitrate_index(&self, rate: u32) -> Result<u32, Error> { self.ctx.get_target_bitrate_inx(rate).map_err(map) }
+    pub fn last_bitrate(&self) -> u32 { self.ctx.last_bitrate() }
+    pub fn set_bitrate_kbps(&mut self, kbps: u32) -> Result<(), Error> { self.ctx.set_target_bitrate_kbps(kbps).map_err(map) }
+    pub fn quality_mode(&self) -> u32 { self.ctx.quality_status() }
+}
+pub fn context_size() -> usize { std::mem::size_of::<Context>() }
diff --git a/app/src/crates/lhdcv5-sys/tests/backend_probe.rs b/app/src/crates/lhdcv5-sys/tests/backend_probe.rs
new file mode 100644
--- /dev/null
+++ b/app/src/crates/lhdcv5-sys/tests/backend_probe.rs
@@ -0,0 +1,33 @@
+//! Same deterministic, non-silent 24-bit input and mid-stream rate switches
+//! for both native backends. Reports encoded-byte fingerprints and CPU time.
+use lhdcv5_sys::{LhdcV5Enc,ffi,BACKEND};
+#[test]
+fn deterministic_audio_and_rate_switches() {
+    for rate in [44100,48000,96000,192000] {
+        let mut e=LhdcV5Enc::new().unwrap();
+        e.init_encoder(rate,24,ffi::LHDC_QUALITY_LOW,1011,20).unwrap();
+        let block=e.block_size().unwrap() as usize;
+        let mut pcm=vec![0u8;block*6];let mut out=vec![0u8;8192];
+        let mut state=0x12345678u32;
+        for quality in [5,6,7,8,6,5] {
+            e.set_bitrate_index(quality,false).unwrap();
+            let mut hash=0xcbf29ce484222325u64;let mut bytes=0;let mut frames=0;
+            let mut timings=Vec::new();
+            for _ in 0..400 {
+                for sample in pcm.chunks_exact_mut(3) {
+                    state=state.wrapping_mul(1664525).wrapping_add(1013904223);
+                    sample.copy_from_slice(&((state as i32)>>4).to_le_bytes()[..3]);
+                }
+                let start=std::time::Instant::now();
+                let r=e.encode(&pcm,&mut out).unwrap();
+                timings.push(start.elapsed().as_nanos() as u64);
+                assert!(r.bytes<=1011);bytes+=r.bytes;frames+=r.frames;
+                for &b in &out[..r.bytes] {hash=(hash^u64::from(b)).wrapping_mul(0x100000001b3);}
+            }
+            timings.sort_unstable();
+            println!("PROBE backend={BACKEND:?} rate={rate} quality={quality} bytes={bytes} frames={frames} hash={hash:016x} mean_us={:.1} p95_us={:.1} max_us={:.1}",
+                timings.iter().sum::<u64>() as f64/400_000.0,timings[379] as f64/1000.0,timings[399] as f64/1000.0);
+            assert!(frames>=396);
+        }
+    }
+}
diff --git a/app/src/crates/pipeline/src/media_clock.rs b/app/src/crates/pipeline/src/media_clock.rs
new file mode 100644
--- /dev/null
+++ b/app/src/crates/pipeline/src/media_clock.rs
@@ -0,0 +1,60 @@
+//! RTP sample clock scheduling, independent of bitrate and packet byte size.
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+pub struct MediaClock {
+    origin: Option<Instant>,
+    previous_ts: u32,
+    samples: u64,
+}
+impl MediaClock {
+    pub fn reset(&mut self) { *self = Self::default(); }
+
+    /// Initial 20 ms cushion absorbs capture/encoding bursts. Recover from a
+    /// long scheduling stall by shifting the clock instead of burst-sending
+    /// all overdue packets. RTP timestamps themselves remain untouched.
+    pub fn deadline(&mut self, ts: u32, rate: u32, now: Instant) -> (Instant, bool) {
+        let Some(origin) = self.origin else {
+            let due = now + Duration::from_millis(20);
+            self.origin = Some(due);
+            self.previous_ts = ts;
+            return (due,false);
+        };
+        self.samples += u64::from(ts.wrapping_sub(self.previous_ts));
+        self.previous_ts = ts;
+        // Divide the accumulated sample count, not each packet's rounded
+        // duration: 44.1 kHz and timestamp wrap never accumulate rounding drift.
+        let offset = Duration::from_nanos((u128::from(self.samples) * 1_000_000_000 / u128::from(rate.max(1))) as u64);
+        let due = origin + offset;
+        if now.saturating_duration_since(due) > Duration::from_millis(30) {
+            self.origin = Some(now);
+            self.samples = 0;
+            (now,true)
+        } else { (due,false) }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn sample_clock_is_exact_at_44100_and_across_rtp_wrap() {
+        let mut c=MediaClock::default(); let t=Instant::now();
+        let start=u32::MAX-100;
+        let (first,_)=c.deadline(start,44100,t);
+        for n in 1..10000u32 {
+            let expected=first+Duration::from_nanos(u64::from(n)*240*1_000_000_000/44100);
+            assert_eq!(c.deadline(start.wrapping_add(n*240),44100,expected).0,expected);
+        }
+    }
+    #[test]
+    fn capture_bursts_are_spaced_and_long_stalls_rebase() {
+        let mut c=MediaClock::default(); let t=Instant::now();
+        let first=c.deadline(0,48000,t).0;
+        assert_eq!(c.deadline(240,48000,t).0,first+Duration::from_millis(5));
+        let late=t+Duration::from_millis(100);
+        assert_eq!(c.deadline(480,48000,late),(late,true));
+        assert_eq!(c.deadline(720,48000,late),(late+Duration::from_millis(5),false));
+        c.reset(); assert_eq!(c.deadline(0,48000,late).0,late+Duration::from_millis(20));
+    }
+}
