+const LHDC_ENC_IN_MTU_MAX: MtuSize = 8192;
+const LHDC_ENC_IN_MTU_3MBPS: MtuSize = 1023;
+const LHDC_ENC_IN_MTU_2MBPS: MtuSize = 660;
+const LHDC_ENC_IN_MTU_MIN: MtuSize = 300;
