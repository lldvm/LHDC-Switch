+            + ((scratch[9].i as i64 * yb.i as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
+        scratch[6].i = -(((scratch[10].r as i64 * ya.i as i64 + (1 << (31 - 1)) as i64) >> 31)
